<?xml version='1.0' encoding='utf-8'?>
<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>vertical</Layout>
    <Size>100me,48f</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>FonsBarra</ObjectName>
        <Layout>horizontal</Layout>
        <Size>100me,48f</Size>
        <Children>
          <PushButton>
            <ObjectName>WaveViewButton</ObjectName>
            <Size>110f,48f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>WAVES 1+2</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>WAVES 1+2</Text>
            </State>
            <Connection>
              <ConfigKey>[Skin],wave12</ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],wave12</ConfigKey>
              <BindProperty>enabled</BindProperty>
              <Transform>
                <Not />
              </Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>WaveViewButton</ObjectName>
            <Size>110f,48f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>WAVES 3+4</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>WAVES 3+4</Text>
            </State>
            <Connection>
              <ConfigKey>[Skin],wave34</ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],wave34</ConfigKey>
              <BindProperty>enabled</BindProperty>
              <Transform>
                <Not />
              </Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>WaveViewButton</ObjectName>
            <Size>110f,48f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>4 WAVES</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>4 WAVES</Text>
            </State>
            <Connection>
              <ConfigKey>[Skin],wave4</ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],wave4</ConfigKey>
              <BindProperty>enabled</BindProperty>
              <Transform>
                <Not />
              </Transform>
            </Connection>
          </PushButton>
          <WidgetGroup>
            <Size>0me,48f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TopbarClockWrapper</ObjectName>
            <Layout>horizontal</Layout>
            <Size>60f,48f</Size>
            <Children>
              <Time>
                <ObjectName>TopbarClock</ObjectName>
                <TooltipId>time</TooltipId>
                <Size>60f,48f</Size>
                <Alignment>center</Alignment>
              </Time>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>12f,48f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TopbarRecWrapper</ObjectName>
            <Layout>horizontal</Layout>
            <Size>70f,48f</Size>
            <Children>
              <Label>
                <ObjectName>TopbarRecCircle</ObjectName>
                <Text>●</Text>
                <Connection>
                  <ConfigKey>[Recording],status</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </Label>
              <WidgetGroup>
                <Size>4f,48f</Size>
              </WidgetGroup>
              <RecordingDuration>
                <ObjectName>TopbarRecDuration</ObjectName>
                <Size>60f,48f</Size>
                <InactiveText>REC</InactiveText>
                <Alignment>center</Alignment>
                <Connection>
                  <ConfigKey>[Recording],status</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </RecordingDuration>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>12f,48f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TopbarMasterVuWrapper</ObjectName>
            <Layout>vertical</Layout>
            <Size>70f,48f</Size>
            <Children>
              <VuMeter>
                <ObjectName>TopbarMasterVuL</ObjectName>
                <Size>70f,4f</Size>
                <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
                <PathVu scalemode="STRETCH">icons/master_vu_fg.png</PathVu>
                <Horizontal>true</Horizontal>
                <PeakHoldSize>5</PeakHoldSize>
                <PeakHoldTime>300</PeakHoldTime>
                <PeakFallTime>20</PeakFallTime>
                <PeakFallStep>1</PeakFallStep>
                <Connection>
                  <ConfigKey>[Main],vu_meter_left</ConfigKey>
                </Connection>
              </VuMeter>
              <WidgetGroup>
                <Size>70f,1f</Size>
              </WidgetGroup>
              <VuMeter>
                <ObjectName>TopbarMasterVuR</ObjectName>
                <Size>70f,4f</Size>
                <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
                <PathVu scalemode="STRETCH">icons/master_vu_fg.png</PathVu>
                <Horizontal>true</Horizontal>
                <PeakHoldSize>5</PeakHoldSize>
                <PeakHoldTime>300</PeakHoldTime>
                <PeakFallTime>20</PeakFallTime>
                <PeakFallStep>1</PeakFallStep>
                <Connection>
                  <ConfigKey>[Main],vu_meter_right</ConfigKey>
                </Connection>
              </VuMeter>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>0me,48f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TabControls</ObjectName>
            <Layout>horizontal</Layout>
            <Size>100f,48f</Size>
            <Children>
              <PushButton>
                <ObjectName>NavBrowseBtn</ObjectName>
                <Size>100f,48f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>BROWSE</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>BROWSE</Text>
                </State>
                <Connection>
                  <ConfigKey>[Tab],library</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[Tab],library</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform>
                    <Not />
                  </Transform>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>NavBackBtn</ObjectName>
                <Size>100f,48f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>BACK</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>BACK</Text>
                </State>
                <Connection>
                  <ConfigKey>[Tab],overview</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[Tab],library</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>8f,48f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TabControls</ObjectName>
            <Layout>horizontal</Layout>
            <Size>100f,48f</Size>
            <Children>
              <Template src="skin:tab.xml">
                <SetVariable name="tab_name">SETUP</SetVariable>
                <SetVariable name="config_key">shortcut</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>