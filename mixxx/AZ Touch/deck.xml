<?xml version='1.0' encoding='utf-8'?>
<Template>
  <WidgetGroup>
    <ObjectName>Deck</ObjectName>
    <Layout>vertical</Layout>
    <Children>
      <WidgetGroup>
        <ObjectName>DeckMetadata</ObjectName>
        <Layout>horizontal</Layout>
        <Size>100me,22f</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>DeckNumber</ObjectName>
            <Layout>vertical</Layout>
            <Size>30f,22f</Size>
            <Children>
              <Label>
                <ObjectName>DeckName</ObjectName>
                <Size>22f,11f</Size>
                <Text>DECK</Text>
              </Label>
              <WidgetGroup>
                <ObjectName>DeckActive</ObjectName>
                <Layout>horizontal</Layout>
                <Size>22f,11f</Size>
                <Children>
                  <Label>
                    <ObjectName>DeckPlaying</ObjectName>
                    <Text>(( </Text>
                    <Style>
                                color: #d73535;
                              </Style>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel" />],play</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>DeckChannelTitle</ObjectName>
                    <Text>
                      <Variable name="channel" />
                    </Text>
                  </Label>
                  <Label>
                    <ObjectName>DeckPlaying</ObjectName>
                    <Text> ))</Text>
                    <Style>
                                color: #d73535;
                              </Style>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel" />],play</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>10f,0f</Size>
          </WidgetGroup>
          <TrackProperty>
            <ObjectName>DeckTitleText</ObjectName>
            <Size>100me,22f</Size>
            <TooltipId>track_title</TooltipId>
            <Property>titleInfo</Property>
            <Alignment>Left</Alignment>
            <Elide>right</Elide>
            <Channel>
              <Variable name="channel" />
            </Channel>
          </TrackProperty>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>DeckRow1</ObjectName>
        <Layout>horizontal</Layout>
        <Size>100me,38f</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>QuantizeCol</ObjectName>
            <Layout>vertical</Layout>
            <Size>28f,38f</Size>
            <Children>
              <WidgetGroup>
                <Size>0f,5f</Size>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>28f,28f</Size>
                <Children>
                  <WidgetGroup>
                    <Size>0f,28f</Size>
                  </WidgetGroup>
                  <PushButton>
                    <NumberStates>2</NumberStates>
                    <Size>28f,28f</Size>
                    <State>
                      <Number>0</Number>
                      <Text>Q</Text>
                    </State>
                    <State>
                      <Number>1</Number>
                      <Text>Q</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel" />],quantize</ConfigKey>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>4f,38f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TrackTimeContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>240f,38f</Size>
            <Children>
              <NumberPos>
                <ObjectName>DeckTrackTime</ObjectName>
                <MinimumSize>240,38</MinimumSize>
                <TooltipId>track_time</TooltipId>
                <NumberOfDigits>8</NumberOfDigits>
                <Channel>
                  <Variable name="channel" />
                </Channel>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel" />],playposition</ConfigKey>
                </Connection>
                <FgColor>#e5e7eb</FgColor>
              </NumberPos>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>38me,38f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>PitchCurrent<Variable name="channel" />
            </ObjectName>
            <Layout>vertical</Layout>
            <Size>100me,38f</Size>
            <Children>
              <WidgetGroup>
                <Size>100f,4f</Size>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>PitchTopRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>me,19f</Size>
                <Children>
                  <Label>
                    <ObjectName>MasterTempo</ObjectName>
                    <Size>19f,19f</Size>
                    <Text>MT</Text>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel" />],keylock</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Label>
                  <WidgetGroup>
                    <Size>4f,38f</Size>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>DeckBPMRangePercent</ObjectName>
                    <Size>30f,11f</Size>
                    <Layout>horizontal</Layout>
                    <Children>
                      <Label>
                        <ObjectName>BPMRangePlusMinus</ObjectName>
                        <Text>±</Text>
                      </Label>
                      <RateRange>
                        <TooltipId>rate_range_display</TooltipId>
                        <ObjectName>RateDisplay</ObjectName>
                        <Channel>
                          <Variable name="channel" />
                        </Channel>
                        <Display>range</Display>
                        <Size>11f,0me</Size>
                      </RateRange>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>PitchBottomRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>me,19f</Size>
                <Children>
                  <WidgetGroup>
                    <Size>15f,19f</Size>
                  </WidgetGroup>
                  <NumberRate>
                    <TooltipId>rate_display</TooltipId>
                    <ObjectName>PitchCurrent</ObjectName>
                    <Channel>
                      <Variable name="channel" />
                    </Channel>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Size>38f,19f</Size>
                  </NumberRate>
                  <Label>
                    <ObjectName>BPMPercent</ObjectName>
                    <Text>%</Text>
                    <Size>23f,19f</Size>
                  </Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>8f,38f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TrackBPMContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>58max,30f</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>DeckBPMWrapper</ObjectName>
                <Layout>vertical</Layout>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel" />],sync_leader</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
                <Children>
                  <WidgetGroup>
                    <ObjectName>DeckBPMTitleWrapper</ObjectName>
                    <Layout>stacked</Layout>
                    <Size>58f,11f</Size>
                    <Children>
                      <Label>
                        <ObjectName>DeckBPMTitle</ObjectName>
                        <Text>BPM</Text>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],sync_enabled</ConfigKey>
                          <BindProperty>visible</BindProperty>
                          <Transform>
                            <Not />
                          </Transform>
                        </Connection>
                      </Label>
                      <Label>
                        <ObjectName>DeckBPMTitleSync</ObjectName>
                        <Text>BEAT SYNC</Text>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],sync_mode</ConfigKey>
                          <BindProperty>visible</BindProperty>
                          <Transform>
                            <IsEqual>1</IsEqual>
                          </Transform>
                        </Connection>
                      </Label>
                      <Label>
                        <ObjectName>DeckBPMTitleMaster</ObjectName>
                        <Text>MASTER</Text>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],sync_leader</ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </Label>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>DeckBPMNumberWrapper</ObjectName>
                    <Layout>stacked</Layout>
                    <Size>58f,19f</Size>
                    <Children>
                      <NumberBpm>
                        <ObjectName>DeckBPM</ObjectName>
                        <TooltipId>visual_bpm</TooltipId>
                        <Channel>
                          <Variable name="channel" />
                        </Channel>
                        <NumberOfDigits>1</NumberOfDigits>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],visual_bpm</ConfigKey>
                        </Connection>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],sync_leader</ConfigKey>
                          <BindProperty>visible</BindProperty>
                          <Transform>
                            <Not />
                          </Transform>
                        </Connection>
                      </NumberBpm>
                      <NumberBpm>
                        <ObjectName>DeckBPMMaster</ObjectName>
                        <TooltipId>visual_bpm</TooltipId>
                        <Channel>
                          <Variable name="channel" />
                        </Channel>
                        <NumberOfDigits>1</NumberOfDigits>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],visual_bpm</ConfigKey>
                        </Connection>
                        <Connection>
                          <ConfigKey>[Channel<Variable name="channel" />],sync_leader</ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </NumberBpm>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>8f,38f</Size>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>DeckRow2</ObjectName>
        <Layout>horizontal</Layout>
        <Size>100me,27f</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>KeyWrapper</ObjectName>
            <Size>28f,27f</Size>
            <Layout>vertical</Layout>
            <Children>
              <WidgetGroup>
                <Size>19f,8f</Size>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>23f,15f</Size>
                <Children>
                  <Key>
                    <ObjectName>KeyInfo</ObjectName>
                    <Size>23f,15f</Size>
                    <TooltipId>visual_key</TooltipId>
                    <DisplayCents>false</DisplayCents>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel" />],visual_key</ConfigKey>
                    </Connection>
                  </Key>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Size>4f,27f</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>DeckOverviewContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,27f</Size>
            <Children>
              <Overview>
                <ObjectName>DeckOverview</ObjectName>
                <Size>me,54f</Size>
                <Channel>
                  <Variable name="channel" />
                </Channel>
                <BgColor>#000</BgColor>
                <SignalColor>#222</SignalColor>
                <SignalLowColor>#1678ff</SignalLowColor>
                <SignalMidColor>#f6a21a</SignalMidColor>
                <SignalHighColor>#f7f1dd</SignalHighColor>
                <PlayedOverlayColor>#40ffffff</PlayedOverlayColor>
                <Mark>
                  <Control>cue_point</Control>
                  <Color>#eb870f</Color>
                </Mark>
                <Mark>
                  <Control>hotcue_1_position</Control>
                  <Text>A</Text>
                  <Color>#f44040</Color>
                  <TextColor>#f44040</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_2_position</Control>
                  <Text>B</Text>
                  <Color>#0ddcf2</Color>
                  <TextColor>#0ddcf2</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_3_position</Control>
                  <Text>C</Text>
                  <Color>#a5df13</Color>
                  <TextColor>#a5df13</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_4_position</Control>
                  <Text>D</Text>
                  <Color>#9d4cfd</Color>
                  <TextColor>#9d4cfd</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_5_position</Control>
                  <Text>E</Text>
                  <Color>#3fec2b</Color>
                  <TextColor>#3fec2b</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_6_position</Control>
                  <Text>F</Text>
                  <Color>#e6681c</Color>
                  <TextColor>#e6681c</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_7_position</Control>
                  <Text>G</Text>
                  <Color>#2749c8</Color>
                  <TextColor>#2749c8</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>hotcue_8_position</Control>
                  <Text>H</Text>
                  <Color>#c7b205</Color>
                  <TextColor>#c7b205</TextColor>
                  <Align>top</Align>
                </Mark>
                <Mark>
                  <Control>loop_start_position</Control>
                  <Color>#f09c40</Color>
                </Mark>
                <Mark>
                  <Control>loop_end_position</Control>
                  <Color>#f09c40</Color>
                </Mark>
                <MarkRange>
                  <StartControl>loop_start_position</StartControl>
                  <EndControl>loop_end_position</EndControl>
                  <EnabledControl>loop_enabled</EnabledControl>
                  <Color>#f09c40</Color>
                  <Opacity>0.5</Opacity>
                  <DisabledColor>#acacac</DisabledColor>
                  <DisabledOpacity>0.2</DisabledOpacity>
                </MarkRange>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel" />],playposition</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[Skin],wave_touch_enabled</ConfigKey>
                  <BindProperty>enabled</BindProperty>
                </Connection>
                <Connection>
                  <ConfigKey>[Skin],wave_touch_enabled</ConfigKey>
                  <BindProperty>acceptDrops</BindProperty>
                </Connection>
              </Overview>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>